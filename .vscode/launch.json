    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "(lldb) 启动",
            "program": "${workspaceFolder}/main.exe",
            "stopOnEntry": false,
            "args": [],
            "cwd": "${workspaceFolder}",
            "initCommands": [

            ],
            "console": "internalConsole",
            "preLaunchTask": "debug"
        },
        
        {
            "name": "(gdb) 启动",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main.exe",
            "args": [
            ],
            "stopAtEntry": false,
            // "cwd": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "debug"
        }

    ]
}